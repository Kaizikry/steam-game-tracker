# ---- Database ----------------------------------------------------------------
# Supabase: Project → Connect (top bar) → "ORMs" tab → Prisma shows both values.
#   DATABASE_URL = Transaction pooler (port 6543), keep ?pgbouncer=true
#   DIRECT_URL   = Session pooler (port 5432), used only for migrations
# Copy them from there; only replace [YOUR-PASSWORD] with your database password.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST].pooler.supabase.com:5432/postgres"

# Local Postgres instead (docker compose up -d postgres): use the same URL for both.
# DATABASE_URL="postgresql://steamtracker:steamtracker@localhost:5432/steamtracker"
# DIRECT_URL="postgresql://steamtracker:steamtracker@localhost:5432/steamtracker"

# ---- Steam ---------------------------------------------------------------------
# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""

# ---- Server --------------------------------------------------------------------
# Secret used to sign session tokens. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-in-production-please-32chars"

# Origin allowed by CORS (the frontend URL)
FRONTEND_URL="http://localhost:5173"

PORT=3001
