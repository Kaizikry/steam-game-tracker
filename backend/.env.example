# PostgreSQL connection string (docker-compose.yml provides this one)
DATABASE_URL="postgresql://steamtracker:steamtracker@localhost:5432/steamtracker"

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""

# Secret used to sign session tokens. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-in-production-please-32chars"

# Origin allowed by CORS (the frontend URL)
FRONTEND_URL="http://localhost:5173"

PORT=3001
